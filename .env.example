# Copy these into your host's environment-variable / secrets panel.
# Locally they live in .streamlit/secrets.toml instead (gitignored).
GEMINI_API_KEY=
ALPHA_VANTAGE_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The public origin of the deployed app, no trailing slash.
# Must exactly match an entry in Supabase Auth > URL Configuration > Redirect URLs.
APP_BASE_URL=https://your-domain.com
